# Douyin Spark Fusion - Environment Configuration
# Copy this file to .env and fill in your values

# Server
PORT=8000
AUTH_TOKEN=         # Auto-generated if empty, or set a custom token

# Notifications (optional, configure any you want)
DINGTALK_WEBHOOK=   # https://oapi.dingtalk.com/robot/send?access_token=...
DINGTALK_SECRET=    # Signing secret for DingTalk
FEISHU_WEBHOOK=     # https://open.feishu.cn/open-apis/bot/v2/hook/...
FEISHU_SECRET=      # Signing secret for Feishu
WECOM_WEBHOOK=      # https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=...
TELEGRAM_BOT_TOKEN= # 123456:ABC-DEF1234
TELEGRAM_CHAT_ID=   # -1001234567890
BARK_DEVICE_KEY=    # Your Bark device key
BARK_URL=           # https://api.day.app (default)
SMTP_HOST=          # smtp.qq.com
SMTP_PORT=465
SMTP_USER=          # your@email.com
SMTP_PASS=          # SMTP authorization code
MAIL_TO=            # recipient@email.com